---
import data from '../data/data.json';

const esc = (s) => s.replace(/&/g, '&amp;');
// Golden target: blank line after <ul>, before </ul>, and between every <li>.
// Astro's expression loops collapse that untrimmed whitespace, so the list is
// built as a plain string and injected with set:html.
const items =
  data.stocks
    .map((s) => `\n\n  <li><a href="/stocks/${s.ticker}/">${esc(s.name)}</a> — ${esc(s.sector)}</li>`)
    .join('') + '\n\n';
---
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8">
<link rel="stylesheet" href="/style.css">
<title>Demo — dividend stocks</title>
<link rel="canonical" href="https://demo.example/">
<meta property="og:title" content="Demo — dividend stocks">
<meta property="og:url" content="https://demo.example/">
<meta property="og:type" content="website">
</head>
<body>
<h1>Stocks (cycle {data.cycle_id})</h1>
<ul set:html={items}></ul>
</body>
</html>
